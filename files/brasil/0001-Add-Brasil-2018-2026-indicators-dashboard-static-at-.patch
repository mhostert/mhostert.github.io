+.br-chart svg { display: block; width: 100%; height: auto; overflow: visible; }
+.br-tip { position: absolute; display: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); pointer-events: none; z-index: 2; white-space: nowrap; }
