+.br-tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-xs); }
+.br-tile .br-label { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }
+.br-tile .br-num { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); line-height: 1.1; }
+.br-tile .br-delta { font-size: var(--cds-font-size-caption); }
+.br-tile .br-delta.good { color: var(--color-ok); }
+.br-tile .br-delta.bad { color: var(--color-bad); }
+.br-section { margin-bottom: var(--cds-gap-xl); }
+.br-section h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0 0 var(--cds-gap-xs); padding-top: var(--cds-gap-sm); }
+.br-section .br-lead { margin: 0 0 var(--cds-gap-md); color: var(--color-fg-muted); font-size: var(--cds-font-size-body); max-width: 60rem; }
+.br-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--cds-gap-md); }
+.br-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-sm); }
+.br-card h3 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }
+.br-card .br-note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin: 0; }
+.br-card .br-text { font-size: var(--cds-font-size-body); margin: 0; }
