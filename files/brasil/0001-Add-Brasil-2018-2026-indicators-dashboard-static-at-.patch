+<meta property="og:title" content="Brasil 2018–2026: o que melhorou (e o que não)">
+<meta property="og:description" content="Indicadores oficiais, cada número clicável até a fonte, com o lado oposto escrito junto.">
+<meta property="og:type" content="website">
+<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%87%A7%F0%9F%87%B7%3C/text%3E%3C/svg%3E">
+<style>
+:root {
+  color-scheme: light dark;
+  --font-anthropic-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  --font-anthropic-serif: Georgia, "Iowan Old Style", "Times New Roman", serif;
+  --cds-font-size-caption: 0.8125rem; --cds-font-size-body: 0.9375rem; --cds-font-size-heading: 1.0625rem; --cds-font-size-title: 1.75rem;
+  --cds-font-weight-medium: 600;
+  --cds-gap-xs: .375rem; --cds-gap-sm: .625rem; --cds-gap-md: 1rem; --cds-gap-lg: 1.5rem; --cds-gap-xl: 2.5rem;
+  --cds-pad-xs: .375rem; --cds-pad-sm: .625rem; --cds-pad-md: .875rem; --cds-pad-lg: 1.25rem;
+  --cds-radius: .625rem; --cds-dur-slow: .3s; --cds-ease-out: ease-out;
+  --color-bg: #f6f5f1; --color-panel: #ffffff; --color-fg: #1b1b1b; --color-fg-muted: #66635c; --color-border-line: #e1dfd8;
+  --color-ok: #1f7a4d; --color-warn: #a86a12; --color-bad: #b3261e;
+  --cds-chart-grid: #ebe9e4; --cds-chart-axis: #c9c6bf; --cds-chart-reference: #8f8c84; --cds-chart-muted: #c9c6bf; --cds-chart-status-critical: #b3261e;
+  --cds-surface-popover: #ffffff; --cds-border: #d6d3cb; --cds-shadow-popover: 0 6px 20px rgba(0,0,0,.14); --cds-text-secondary: #66635c;
+}
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) {
+    --color-bg: #151515; --color-panel: #1f1f1f; --color-fg: #ededed; --color-fg-muted: #a3a09a; --color-border-line: #333;
+    --color-ok: #4fc08a; --color-warn: #e0a84a; --color-bad: #f0665c;
+    --cds-chart-grid: #2a2a2a; --cds-chart-axis: #4a4a4a; --cds-chart-reference: #8a8a8a; --cds-chart-muted: #4a4a4a; --cds-chart-status-critical: #f0665c;
+    --cds-surface-popover: #262626; --cds-border: #3d3d3d; --cds-shadow-popover: 0 6px 20px rgba(0,0,0,.5); --cds-text-secondary: #a3a09a;
+  }
+}
+html, body { margin: 0; background: var(--color-bg); color: var(--color-fg); font-family: var(--font-anthropic-sans); -webkit-text-size-adjust: 100%; }
+#dash-root { padding: 1rem clamp(.75rem, 3vw, 2rem) 3rem; }
+.site-bar { max-width: 74rem; margin: 0 auto .75rem; display: flex; justify-content: space-between; align-items: center; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }
+.site-bar a { color: var(--color-fg); text-decoration: none; }
+.site-bar a:hover { text-decoration: underline; }
+.dash-skeleton { position: relative; min-height: 1em; background: linear-gradient(90deg, var(--color-border-line), var(--color-bg), var(--color-border-line)); background-size: 200% 100%; animation: shimmer 1.4s infinite; border-radius: 4px; color: transparent !important; }
+@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
+[data-source] { cursor: help; text-decoration: underline dotted; text-decoration-color: var(--cds-chart-reference); text-underline-offset: 3px; }
+.br-chart[data-source], .br-tile .br-label span[data-source] { text-decoration: none; }
+.br-chart[data-source] { cursor: default; }
+.src-pop { position: fixed; z-index: 50; max-width: min(26rem, calc(100vw - 2rem)); background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-md); font-size: var(--cds-font-size-caption); color: var(--color-fg); display: none; }
+.src-pop.on { display: block; }
+.src-pop h4 { margin: 0 0 .35rem; font-size: var(--cds-font-size-body); font-weight: 600; }
+.src-pop p { margin: 0 0 .5rem; color: var(--cds-text-secondary); }
+.src-pop .src-row { margin: 0 0 .5rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .75rem; white-space: pre-wrap; word-break: break-word; }
+.src-pop pre { margin: .25rem 0 .5rem; max-height: 14rem; overflow: auto; font-size: .7rem; background: var(--color-bg); padding: .5rem; border-radius: 6px; }
+.src-pop a { color: var(--color-fg); }
+.src-pop .src-close { position: absolute; top: .4rem; right: .6rem; border: 0; background: none; font-size: 1rem; cursor: pointer; color: var(--color-fg-muted); }
+.site-foot { max-width: 74rem; margin: 2rem auto 0; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }
+.site-foot a { color: var(--color-fg); }
+</style>
